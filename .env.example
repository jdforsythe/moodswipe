DAILY_PHOTO_CALLS=YOUR_DAILY_PHOTO_CALL_LIMIT
ALLOWED_ORIGINS=YOUR_OPTIONAL_COMMA_SEPARATED_ORIGINS
PEXELS_API_KEY=YOUR_PEXELS_API_KEY
